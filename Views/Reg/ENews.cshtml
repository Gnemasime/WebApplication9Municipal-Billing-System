    <script>
const apiKey = '6c55e14d26f2c4c9e9b9d086f5747c1c'; // Replace with your GNews API key
const query = 'electricity';
const country = 'ZA'; // South Africa

async function fetchNews() {
    const url = `https://gnews.io/api/v4/search?q=${encodeURIComponent(query)}&country=${country}&token=${apiKey}`;

    try {
        const response = await fetch(url);
        if (!response.ok) {
            throw new Error('Network response was not ok');
        }
        const data = await response.json();
        displayNews(data.articles);
    } catch (error) {
        console.error('Error fetching news:', error);
    }
}

function displayNews(articles) {
    const container = document.getElementById('news-container');
    container.innerHTML = '';

    articles.forEach(article => {
        const articleDiv = document.createElement('div');
        const imageUrl = article.image || 'https://via.placeholder.com/150'; // Use a placeholder if no image
        articleDiv.innerHTML = `
            <div class="card mb-4">
                <img src="${imageUrl}" class="card-img-top" alt="Article Image" onerror="this.onerror=null; this.src='https://via.placeholder.com/150';">
                <div class="card-body">
                    <h5 class="card-title"><a href="${article.url}" target="_blank">${article.title}</a></h5>
                    <p class="card-text">${article.description}</p>
                    <p class="card-text"><small class="text-muted">${new Date(article.publishedAt).toLocaleString()}</small></p>
                </div>
            </div>
        `;
        container.appendChild(articleDiv);
    });
}
// Fetch news on page load
fetchNews();


    </script>
