@model WebApplication9Municipal_Billing_System.Models.Water

<h2>Delete Water Record</h2>

<h4>Are you sure you want to delete this?</h4>
<div>
    <h4>Water</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Usage</dt>
        <dd class="col-sm-10">@Model.Usage</dd>

        <dt class="col-sm-2">Rate</dt>
        <dd class="col-sm-10">@Model.Rate</dd>

        <dt class="col-sm-2">Cost</dt>
        <dd class="col-sm-10">@Model.Cost</dd>

        <dt class="col-sm-2">Due Date</dt>
        <dd class="col-sm-10">@Model.DueDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.status</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="WaterId" />
    <button type="submit" class="btn btn-danger">Delete</button>
</form>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>
