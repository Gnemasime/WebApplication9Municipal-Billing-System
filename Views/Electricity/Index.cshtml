@model IEnumerable<WebApplication9Municipal_Billing_System.Models.Electricity>  
  
@{  
   ViewData["Title"] = "Index";  
}  
  <!-- Main Content -->
    <div class="container-fluid">
        <div class="profile-container">

<h1>Electricity</h1>  
 
<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Create New
    </a>
</div>  
  
<table class="table table-bordered table-striped" style="background-color: #f9f9f9;">   
   <thead class="thead-dark">  
      <tr>  
        <th>Electricity Id</th>  
        <th>Usage</th>  
        <th>Rate</th>  
        <th>Cost</th>  
        <th>Due Date</th>  
        <th>Status</th>  
        <th>Reg User Id</th>  
        <th>Action</th>  
      </tr>  
   </thead>  
   <tbody>  
      @foreach (var item in Model)  
      {  
        <tr>  
           <td>@item.ElectricityId</td>  
           <td>@item.Usage</td>  
           <td>@item.Rate</td>  
           <td>@item.Cost</td>  
           <td>@item.DueDate</td>  
           <td>@item.status</td>  
           <td>@item.RegUserId</td>  
           <td>  
    <a asp-action="Details" asp-route-id="@item.ElectricityId" class="btn btn-info">    <i class="fas fa-eye"></i> View
                    </a> 
              <a asp-action="Edit" asp-route-id="@item.ElectricityId" class="btn btn-secondary"> <i class="fas fa-edit"></i> Edit</a> 
                
              <a asp-action="Delete" asp-route-id="@item.ElectricityId" class="btn btn-danger"> <i class="fas fa-trash"></i> Delete</a>  
           </td>  
        </tr>  
      }  
   </tbody>  
</table>
        </div>
    </div>