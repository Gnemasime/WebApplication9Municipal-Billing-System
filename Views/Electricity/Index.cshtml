@model IEnumerable<WebApplication9Municipal_Billing_System.Models.Electricity>  
  
@{  
   ViewData["Title"] = "Index";  
}  
 




    <!-- Main Content -->
    <div class="container-fluid">
        <div class="profile-container">
            

<h2>Electricity Usage Records</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Electricity Usage
    </a>
</div>


<form method="get" asp-action="Index">
    <div class="form-group">
        <label for="statusFilter">Filter by Status:</label>
        <select id="statusFilter" name="statusFilter" class="form-control" onchange="this.form.submit()">
            <option value="">All</option>
            @foreach (EStatus status in Enum.GetValues(typeof(WStatus)))
            {
                var statusValue = status.ToString().ToLower();
                var selectedAttribute = Context.Request.Query["statusFilter"] == statusValue ? " selected" : "";

                <option value="@statusValue" >
                    @status
                </option>
            }
        </select>
    </div>
</form>

<table class="table table-bordered table-striped" style="background-color: #f9f9f9;">  
    <thead class="thead-dark">
        <tr>
            <th>#</th>
            <th>Usage</th>
            <th>Rate </th>
            <th>Cost</th>
            <th>User</th>
            <th>DueDate</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ElectricityId</td>
                <td>@item.Usage</td>
                <td>@item.Rate</td>
                <td>@item.Cost</td>
                <td>@item.Reg?.Name @item.Reg?.Surname</td>
                <td>@item.DueDate</td>
                <td>@item.status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ElectricityId" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.ElectricityId" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash"></i> Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>


        </div>
    </div>

 